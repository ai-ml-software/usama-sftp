{
  "name": "usama-sftp",
  "displayName": "Usama SFTP",
  "description": "Easy SFTP, FTP, FTPS and Git HTTPS connections, remote editing and separate local Git checkouts.",
  "version": "2.1.0",
  "publisher": "kosama685",
  "author": "Usama",
  "engines": {
    "vscode": "^1.74.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-ml-software/usama-cv.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "ftp",
    "sftp",
    "sync",
    "remote"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:usama-sftp-remote",
    "workspaceContains:.vscode/usama-sftp.json",
    "onView:usamaSftp.sidebar"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "usamaSftp",
          "title": "Usama SFTP",
          "icon": "resources/usama-server.svg"
        }
      ],
      "panel": [
        {
          "id": "usamaSftpPanel",
          "title": "Usama Transfers",
          "icon": "resources/usama-server.svg"
        }
      ]
    },
    "views": {
      "usamaSftp": [
        {
          "id": "usamaSftp.sidebar",
          "name": "Overview",
          "type": "webview"
        },
        {
          "id": "usamaSftp.servers",
          "name": "SFTP / FTP Servers"
        }
      ],
      "usamaSftpPanel": [
        {
          "id": "usamaSftp.queue",
          "name": "Transfers",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Usama SFTP",
      "properties": {
        "usamaSftp.offerImport": {
          "type": "boolean",
          "default": true,
          "description": "Offer to import existing sftp.json or sftp-sync.json servers."
        },
        "usamaSftp.statusBar.show": {
          "type": "boolean",
          "default": true,
          "description": "Show the active server and transfer count in the status bar."
        },
        "usamaSftp.transfers.reveal": {
          "type": "string",
          "enum": [
            "never",
            "always",
            "onError"
          ],
          "default": "never",
          "description": "When to reveal the Transfers panel."
        },
        "usamaSftp.uploadOnSave.showSuccess": {
          "type": "boolean",
          "default": true,
          "description": "Show a short status message after uploading on save."
        },
        "usamaSftp.git.path": {
          "type": "string",
          "default": "git",
          "description": "Git executable used for HTTPS repositories. Uses Git credential manager; passwords and tokens stay out of usama-sftp.json."
        }
      }
    },
